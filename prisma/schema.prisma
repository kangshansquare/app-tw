// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  name         String       @unique
  passwordHash String
  isActive     Boolean      @default(true)
  isAdmin      Boolean      @default(false)
  tips         Tips[]
  middleware   Middleware[]
  create_time  DateTime     @default(now())
  groups       UserGroup[]
  permVersion  Int          @default(1)
  roles        User_Role[]
}

model Tips {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  ExpireDate  DateTime
  status      String
  priority    String   @default("medium")
  user_id     Int
  create_time DateTime @default(now())
  update_time DateTime @default(now()) @updatedAt
  user        User     @relation(fields: [user_id], references: [id])
}

model OpenVPN {
  id             Int      @id @default(autoincrement())
  name           String   @default("-")
  sector         String   @default("-")
  account_ip     String
  apply_date     DateTime @default(now())
  dest_ip        String
  type           String
  reason         String   @default("工作需要")
  apply_duration String   @default("永久")
  status         String
  description    String   @default("-")
}

model Middleware {
  id             Int      @id @default(autoincrement())
  type           String
  name           String
  version        String
  service_line   String
  deploy_mode    String
  ip_port        String?
  cluster_config Json?
  description    String?
  note           String?
  user_id        Int
  user           User     @relation(fields: [user_id], references: [id])
  create_time    DateTime @default(now())
  update_time    DateTime @default(now()) @updatedAt
  idcId          Int
  idc            Idc      @relation(fields: [idcId], references: [id])
}

model Group {
  id          Int         @id @default(autoincrement())
  name        String
  create_time DateTime    @default(now())
  users       UserGroup[]
}

model UserGroup {
  id       Int      @id @default(autoincrement())
  userId   Int
  groupId  Int
  role     String?
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  group    Group    @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model Idc {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  location    String
  address     String?
  contact     String?
  create_time DateTime     @default(now())
  cabinets    Cabinet[]
  middleware  Middleware[]
  Server      Server[]
}

model Cabinet {
  id          Int      @id @default(autoincrement())
  name        String
  idcId       Int
  idc         Idc      @relation(fields: [idcId], references: [id])
  uCount      Int?
  powerKw     String?
  status      String   @default("active")
  remake      String?
  create_time DateTime @default(now())
  Server      Server[]

  @@unique([idcId, name])
}

model ServiceLine {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  owner       String?
  email       String?
  status      String   @default("active")
  create_time DateTime @default(now())
}

model Logs {
  id          Int      @id @default(autoincrement())
  type        String
  action_time DateTime @default(now())
  operator    String
  ip          String?
  content     String
  status      String
}

model Server {
  id            Int       @id @default(autoincrement())
  type          String
  hostname      String
  os            String
  kernelVersion String
  cpuModel      String
  cpuCores      String
  memoryGB      String
  diskTotal     String
  privateIp     String
  publicIp      String?
  macAddress    String
  serialNumber  String    @unique
  vendor        String?
  idcId         Int
  idc           Idc       @relation(fields: [idcId], references: [id])
  cabinetId     Int
  cabinet       Cabinet   @relation(fields: [cabinetId], references: [id])
  kvms          Int?
  createAt      DateTime  @default(now())
  updateAt      DateTime  @updatedAt
  lastSyncAt    DateTime?
}

enum StatusLABEL {
  active
  deprecated
  hidden
}

model IpRecord {
  id          Int      @id @default(autoincrement())
  ip          String   @unique
  description String?
  createdAt   DateTime @default(now())
}

model CloudProvider {
  id       Int    @id @default(autoincrement())
  provider String
  name     String

  regions  CloudRegion[]
  accounts CloudAccount[]
}

model CloudAccount {
  id                Int           @id @default(autoincrement())
  provider          CloudProvider @relation(fields: [providerId], references: [id])
  providerId        Int
  name              String
  environment       String
  access_key_id     String?
  secret_access_key String?

  createAt  DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model CloudRegion {
  id         Int           @id @default(autoincrement())
  provider   CloudProvider @relation(fields: [providerId], references: [id])
  providerId Int
  regionId   String
  name_en    String
  name_zh    String
  status     StatusLABEL   @default(active)

  @@unique([providerId, regionId])
}

model Role {
  id       Int     @id @default(autoincrement())
  code     String  @unique // 业务唯一码，如 'ADMIN'
  name     String
  version  Int     @default(0) // 乐观锁版本号
  isSystem Boolean @default(false) // 是否系统内置角色，防止误删

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?

  // 关系
  permissions Role_Permission[]
  users       User_Role[]

  @@index([code])
}

model Permission {
  id     Int    @id @default(autoincrement())
  name   String @default("")
  code   String @unique // 业务唯一码，如 'user:read'
  module String // 模块名，如 'user', 'order'
  action String // 动作名，如 'read', 'write', 'delete'

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?

  // 关系
  roles Role_Permission[]

  @@unique([module, action]) // 确保同一模块下的动作不重复
}

model Role_Permission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // 唯一索引：防止同一个角色重复分配同一个权限
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model User_Role {
  id     Int @id @default(autoincrement())
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // 唯一索引：防止同一个用户重复分配同一个角色
  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}
